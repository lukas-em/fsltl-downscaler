<Project>
  <PropertyGroup>
    <Version>1.1.1</Version>
    <Product>FSLTL Downscaler</Product>
    <Authors>FranklinFjM</Authors>
    <Company>FranklinFjM</Company>
    <Copyright>Copyright (c) 2026 FranklinFjM</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>FsltlDownscaler</RootNamespace>
    <!-- Product version without the commit hash, e.g. 1.1.0. Required for the SignPath metadata check. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
